# Bridge local development environment.
# Copy to .env and adjust if needed. `docker compose up -d` provides Postgres + Redis
# matching these defaults.

DATABASE_URL=postgres://bridge:bridge@localhost:5432/bridge
REDIS_URL=redis://localhost:6379
API_PORT=4000

# Logging: debug | info | warn | error
LOG_LEVEL=info
# Set to 1 for human-readable logs in development
LOG_PRETTY=1
