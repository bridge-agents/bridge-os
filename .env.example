# Bridge local development environment. Copy to .env.
#
# The defaults need no Docker and no services: the database is embedded and the
# queue runs in-process, which is also how the desktop app ships.

# postgres://… for a server, pglite:<path> for an embedded database.
DATABASE_URL=pglite:./.bridge/data

# Unset means the in-process queue. Set to redis://localhost:6379 to use BullMQ.
# REDIS_URL=redis://localhost:6379

# Encrypts stored provider credentials. Generate with: openssl rand -base64 32
# Required in production; a throwaway key is generated in development, so saved
# credentials will not survive a restart without setting this.
# BRIDGE_SECRET_KEY=

API_PORT=4000

# Logging: debug | info | warn | error
LOG_LEVEL=info
# Set to 1 for human-readable logs in development
LOG_PRETTY=1
