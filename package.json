{
  "name": "bridge-agent-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "dev": "turbo run dev --filter=@bridge/api --filter=@bridge/web --filter=@bridge/worker",
    "db:generate": "pnpm --filter @bridge/db generate",
    "db:migrate": "pnpm --filter @bridge/db migrate",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "msgpackr-extract"
    ],
    "overrides": {
      "source-map-js": "^1.2.2",
      "@xmldom/xmldom@^0.8.0": "^0.8.15",
      "fast-copy@^4.0.0": "^4.1.0",
      "fast-uri@^3.0.0": "^3.1.8",
      "js-yaml@^4.0.0": "^4.3.2",
      "postcss-selector-parser": "^7.1.6",
      "proxy-addr": "^2.0.8",
      "qs": "^6.16.0",
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  }
}
