{
  "name": "@bridge/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bridge — the Agent OS",
  "main": "dist/main.mjs",
  "author": "Bridge",
  "scripts": {
    "build": "node build.mjs",
    "dev": "pnpm build && electron .",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --publish never",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --publish never",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bridge/core": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "43.8.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
